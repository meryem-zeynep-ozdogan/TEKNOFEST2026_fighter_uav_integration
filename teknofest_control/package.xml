<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>teknofest_control</name>
  <version>1.0.0</version>
  <description>
    TEKNOFEST Savaşan İHA Yarışması - GPS Takip ve Kontrol Paketi
    L1 Guidance Algorithm ile hedef takibi ve PX4 entegrasyonu
  </description>
  <maintainer email="teknofest@havk.team">HAVK Takımı</maintainer>
  <license>Apache-2.0</license>

  <!-- Build Tool -->
  <buildtool_depend>ament_python</buildtool_depend>

  <!-- Runtime Dependencies -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  
  <!-- PX4 Message Dependencies -->
  <exec_depend>px4_msgs</exec_depend>
  
  <!-- Math & Science -->
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>

  <!-- Test Dependencies -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
